    <string name="wol_mac_guide_title">Find your TV\'s MAC address</string>
    <string name="wol_mac_guide_step_one_title">1. Turn on your TV</string>
    <string name="wol_mac_guide_step_one_description">Use the TV remote to open Settings or Help.</string>
    <string name="wol_mac_guide_step_two_title">2. Look for the MAC address</string>
    <string name="wol_mac_guide_step_two_description">Try the menu for your model below. Menu names and locations vary by model.</string>
    <string name="wol_mac_guide_google_model">Google TV Streamer / Chromecast</string>
    <string name="wol_mac_guide_google_path">Settings > System > About > Status</string>
    <string name="wol_mac_guide_tcl_model">TCL Google TV</string>
    <string name="wol_mac_guide_tcl_path">Settings > Network &amp; Internet > select the connected network</string>
    <string name="wol_mac_guide_sony_model">Sony</string>
    <string name="wol_mac_guide_sony_path">Help > Status &amp; Diagnostics > Network status</string>
    <string name="wol_mac_guide_step_three_title">3. Enter the active network\'s MAC</string>
    <string name="wol_mac_guide_step_three_description">Return to the app and enter the Wi-Fi MAC if your TV uses Wi-Fi, or the Ethernet / wired MAC if it uses a cable. These addresses are different. Keep your phone and TV on the same local network.</string>
    <string name="wol_mac_guide_standby_title">Before trying Network Wake</string>
    <string name="wol_mac_guide_standby_description">If offered, enable Network Standby or Remote Start on your TV. Keep the TV plugged in. Network Wake availability varies by model and network connection.</string>
